#!/usr/bin/env python
import os

from misc.utility.scons_hints import *

Import("env")
Import("env_modules")

# The FFmpeg libraries are built per target platform and consumed by the
# private playback implementation. Keep this module boundary separate from
# the legacy WebM/libvpx module during the migration.
env_ffmpeg = env_modules.Clone()
env_ffmpeg.Prepend(CPPPATH=["#thirdparty/libogg/"])

ffmpeg_dir = env["ffmpeg_dir"]
if not ffmpeg_dir:
    print("WARNING: FFmpeg module enabled without ffmpeg_dir; media playback will not be linked.")
    pass

else:
    if env["platform"] == "web":
        variant = "threads" if env["threads"] else "nothreads"
        variant_dir = os.path.join(ffmpeg_dir, variant)
        if os.path.isdir(os.path.join(variant_dir, "include")):
            ffmpeg_dir = variant_dir
        config_path = os.path.join(ffmpeg_dir, "config.h")
        if not env["threads"] and os.path.isfile(config_path):
            with open(config_path, encoding="utf-8") as config:
                if "#define HAVE_PTHREADS 1" in config.read():
                    raise RuntimeError("The no-thread Web template requires a no-thread FFmpeg package.")
    env_ffmpeg.Prepend(CPPPATH=[ffmpeg_dir + "/include"])
    env_modules.Prepend(CPPPATH=[ffmpeg_dir + "/include"])
    env.Append(CPPPATH=[ffmpeg_dir + "/include"])
    lib_prefix = "" if env["platform"] == "windows" else "lib"
    lib_suffix = ".lib" if env["platform"] == "windows" else ".a"
    ffmpeg_libs = [env.File(ffmpeg_dir + "/lib/" + lib_prefix + name + lib_suffix) for name in ["avformat", "avcodec", "swscale", "avutil", "swresample"]]
    env_ffmpeg.Append(LIBS=ffmpeg_libs)
    env.Append(LIBS=ffmpeg_libs)
    if env["platform"] == "windows":
        hw_linkflags = ["d3d11.lib", "d3d12.lib", "dxva2.lib", "ole32.lib", "user32.lib", "advapi32.lib"]
        env_ffmpeg.Append(LINKFLAGS=hw_linkflags)
        env.Append(LINKFLAGS=hw_linkflags)
    elif env["platform"] == "linuxbsd":
        hw_libs = ["va", "va-drm", "vulkan"]
        if not os.path.isfile(ffmpeg_dir + "/deps/lib/libdav1d.a"):
            hw_libs.append("dav1d")
        env_ffmpeg.Append(LIBS=hw_libs)
        env.Append(LIBS=hw_libs)
    elif env["platform"] == "android":
        hw_libs = ["mediandk", "android", "atomic"]
        env_ffmpeg.Append(LIBS=hw_libs)
        env.Append(LIBS=hw_libs)
        # These static libraries are private to Godot. Local binding is required
        # for FFmpeg's direct ARM assembly references to its internal tables.
        private_libs = "libavformat.a:libavcodec.a:libswscale.a:libavutil.a:libswresample.a:libdav1d.a"
        private_linkflags = ["-Wl,--exclude-libs," + private_libs]
        env_ffmpeg.Append(LINKFLAGS=private_linkflags)
        env.Append(LINKFLAGS=private_linkflags)
    elif env["platform"] in ["macos", "ios", "visionos"]:
        hw_linkflags = ["-framework", "VideoToolbox", "-framework", "CoreMedia", "-framework", "CoreVideo"]
        env_ffmpeg.Append(LINKFLAGS=hw_linkflags)
        env.Append(LINKFLAGS=hw_linkflags)
    dav1d_lib = ffmpeg_dir + "/deps/lib/libdav1d.a"
    if os.path.isfile(dav1d_lib):
        env_ffmpeg.Append(LIBS=[env.File(dav1d_lib)])
        env.Append(LIBS=[env.File(dav1d_lib)])
    # Link the static dispatcher, not an import library requiring libvpl.dll.
    vpl_lib = ffmpeg_dir + "/deps/lib/" + ("vpl_static.lib" if env["platform"] == "windows" else "libvpl.a")
    if os.path.isfile(vpl_lib):
        env_ffmpeg.Append(LIBS=[env.File(vpl_lib)])
        env.Append(LIBS=[env.File(vpl_lib)])

module_obj = []
env_ffmpeg.add_source_files(module_obj, "*.cpp")
env.modules_sources += module_obj
