+/* Reopen only the supported single-track fMP4 case. Broader layout/codec
+ * changes remain explicit errors instead of reusing incompatible decoders. */
+static int toi_reopen_epoch(struct playlist *pls, int seeking)
+{
+    HLSContext *c = pls->parent->priv_data;
+    struct segment *seg = current_segment(pls);
+    const AVInputFormat *fmt = pls->ctx->iformat;
+    AVCodecParameters *old = NULL;
+    AVStream *st;
+    AVRational tb;
+    AVDictionary *opts = NULL;
+    int ret;
+
+    if (!seg || !seg->init_section || seg->key_type != KEY_NONE ||
+        seg->program_date_time == AV_NOPTS_VALUE || pls->ctx->nb_streams != 1 ||
+        !strstr(fmt->name, "mov"))
+        return AVERROR(ENOSYS);
+    if (!seeking && pls->toi_last_end_date &&
+        llabs(seg->program_date_time - pls->toi_last_end_date) > INT64_C(30000000))
+        return AVERROR(ENOSYS);
+    st = pls->ctx->streams[0];
+    if (st->codecpar->codec_id != AV_CODEC_ID_H264 && st->codecpar->codec_id != AV_CODEC_ID_AAC)
+        return AVERROR(ENOSYS);
+    tb = st->time_base;
+    old = avcodec_parameters_alloc();
+    if (!old)
+        return AVERROR(ENOMEM);
+    ret = avcodec_parameters_copy(old, st->codecpar);
+    if (ret < 0)
+        goto end;
+
+    pls->ctx->pb = NULL;
+    avformat_close_input(&pls->ctx);
+    /* The old demuxer reached our EOF barrier, so no old bytes remain. */
+    pls->pb.pub.eof_reached = 0;
+    pls->pb.pub.error = 0;
+    pls->pb.pub.buf_ptr = pls->pb.pub.buf_end = pls->pb.pub.buffer;
+    pls->pb.pub.pos = 0;
+    ff_format_io_close(pls->parent, &pls->input);
+    ff_format_io_close(pls->parent, &pls->input_next);
+    pls->input_read_done = pls->input_next_requested = pls->input_reuse = 0;
+    pls->cur_init_section = NULL;
+    pls->init_sec_data_len = pls->init_sec_buf_read_offset = 0;
+    pls->toi_boundary_pending = 0;
+    pls->toi_boundary_seq = pls->cur_seq_no;
+    pls->toi_epoch_date = seg->program_date_time;
+    pls->toi_epoch_pts_known = 0;
+    pls->toi_new_extradata = 1;
+    pls->toi_last_end_date = 0;
+
+    pls->ctx = avformat_alloc_context();
+    if (!pls->ctx) {
+        ret = AVERROR(ENOMEM);
+        goto end;
+    }
+    pls->ctx->pb = &pls->pb.pub;
+    pls->ctx->io_open = nested_io_open;
+    pls->ctx->interrupt_callback = pls->parent->interrupt_callback;
+    pls->ctx->probesize = pls->parent->probesize;
+    pls->ctx->max_analyze_duration = pls->parent->max_analyze_duration;
+    ret = ff_copy_whiteblacklists(pls->ctx, pls->parent);
+    if (ret < 0)
+        goto end;
+    av_dict_copy(&opts, c->seg_format_opts, 0);
+    ret = avformat_open_input(&pls->ctx, seg->url, fmt, &opts);
+    if (ret < 0)
+        goto end;
+    if (pls->ctx->nb_streams != 1) {
+        ret = AVERROR(ENOSYS);
+        goto end;
+    }
+    st = pls->ctx->streams[0];
+    if (av_cmp_q(tb, st->time_base) || old->codec_id != st->codecpar->codec_id ||
+        old->codec_type != st->codecpar->codec_type ||
+        old->width != st->codecpar->width || old->height != st->codecpar->height ||
+        old->sample_rate != st->codecpar->sample_rate ||
+        av_channel_layout_compare(&old->ch_layout, &st->codecpar->ch_layout))
+        ret = AVERROR(ENOSYS);
+end:
+    av_dict_free(&opts);
+    avcodec_parameters_free(&old);
+    return ret;
+}
