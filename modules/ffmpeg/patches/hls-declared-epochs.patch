+static int toi_normalize_epoch_packet(struct playlist *pls)
+{
+    AVStream *st;
+    AVPacket *pkt = pls->pkt;
+    int64_t offset, date;
+    uint8_t *extra;
+    if (pls->toi_epoch_candidate <= 0)
+        return 0;
+    if (pls->ctx->nb_streams != 1 || !strstr(pls->ctx->iformat->name, "mov")) {
+        pls->toi_epoch_candidate = -1;
+        return 0;
+    }
+    st = pls->ctx->streams[0];
+    if (st->codecpar->codec_id != AV_CODEC_ID_H264 && st->codecpar->codec_id != AV_CODEC_ID_AAC) {
+        pls->toi_epoch_candidate = -1;
+        return 0;
+    }
+    if (pkt->pts == AV_NOPTS_VALUE || pkt->dts == AV_NOPTS_VALUE ||
+        st->time_base.num <= 0 || st->time_base.den <= 0)
+        return AVERROR_INVALIDDATA;
+    if (!pls->toi_epoch_pts_known) {
+        if (st->codecpar->codec_type == AVMEDIA_TYPE_VIDEO && !(pkt->flags & AV_PKT_FLAG_KEY))
+            return AVERROR(ENOSYS);
+        pls->toi_epoch_pts = pkt->pts;
+        pls->toi_epoch_pts_known = 1;
+    }
+    date = av_rescale_q(pls->toi_epoch_date, AV_TIME_BASE_Q, st->time_base);
+    /* Explicit limits keep subtractions/additions representable, including
+     * hostile packet timestamps. No guesses for missing or unannounced resets. */
+    if (date <= 0 || date > INT64_MAX / 4 ||
+        pls->toi_epoch_pts < -INT64_MAX / 4 || pls->toi_epoch_pts > INT64_MAX / 4 ||
+        pkt->pts < -INT64_MAX / 4 || pkt->pts > INT64_MAX / 4 ||
+        pkt->dts < -INT64_MAX / 4 || pkt->dts > INT64_MAX / 4 ||
+        pkt->duration < 0 || pkt->duration > INT64_MAX / 4)
+        return AVERROR_INVALIDDATA;
+    offset = date - pls->toi_epoch_pts;
+    pkt->pts += offset;
+    pkt->dts += offset;
+    if (pls->toi_new_extradata && st->codecpar->extradata_size > 0) {
+        extra = av_packet_new_side_data(pkt, AV_PKT_DATA_NEW_EXTRADATA, st->codecpar->extradata_size);
+        if (!extra)
+            return AVERROR(ENOMEM);
+        memcpy(extra, st->codecpar->extradata, st->codecpar->extradata_size);
+    }
+    pls->toi_new_extradata = 0;
+    pls->toi_last_end_date = FFMAX(pls->toi_last_end_date,
+        av_rescale_q(pkt->pts + FFMAX(pkt->duration, 0), st->time_base, AV_TIME_BASE_Q));
+    if (pls->n_main_streams && !pls->toi_reported_timeline) {
+        pls->toi_reported_timeline = 1;
+        /* Observed once during probing, then immutable for decoder threads. */
+        av_dict_set(&pls->main_streams[0]->metadata, "toi_hls_pdt_timeline", "1", 0);
+        pls->main_streams[0]->pts_wrap_bits = 64;
+    }
+    return 0;
+}
