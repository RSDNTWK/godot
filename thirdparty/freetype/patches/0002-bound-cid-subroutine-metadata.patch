+  /* Represent the total in groups of four plus a remainder.  This keeps */
+  /* the overlap limit valid even when four times the stream size would */
+  /* not fit in FT_ULong.                                               */
+  static FT_Bool
+  cid_subrs_budget_add( FT_ULong   value,
+                        FT_ULong   limit,
+                        FT_ULong*  units,
+                        FT_UInt*   remainder )
+  {
+    FT_ULong  part = value / 4;
+    FT_ULong  total;
+    FT_UInt   rest = *remainder + (FT_UInt)( value % 4 );
+
+
+    if ( *units > limit || part > limit - *units )
+      return 0;
+
+    total = *units + part;
+    if ( rest >= 4 )
+    {
+      if ( total == limit )
+        return 0;
+      total++;
+      rest -= 4;
+    }
+
+    *units     = total;
+    *remainder = rest;
+    return 1;
+  }
+
